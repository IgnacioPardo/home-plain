# All browser API requests stay on the same origin.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
# Required for all runs. Generate separate hashes with:
# pnpm --filter @repo/api exec node --import=tsx ../../scripts/hash-password.ts < /path/to/private-password-file
# Keep each hash in single quotes so dotenv preserves its literal dollar signs.
AUTH_SHARED_USERNAME=home
AUTH_SHARED_PASSWORD_HASH=
AUTH_OWNER_USERNAME=owner
AUTH_OWNER_PASSWORD_HASH=
# Optional. With no token the app starts in a clear, unconfigured state.
# Replace the synthetic IDs below with your own before adding a token.
# Share your home page and shopping data source with your integration.
# Read-content capability enables sync; update-content enables checklist completion.
NOTION_API_TOKEN=
NOTION_HOME_PAGE_ID=00000000-0000-4000-8000-000000000901
NOTION_SHOPPING_DATA_SOURCE_ID=00000000-0000-4000-8000-000000000902
NOTION_PRODUCT_REFERENCES_DATA_SOURCE_ID=
NOTION_CACHE_FILE=../../data/notion-shopping.json
NOTION_SYNC_INTERVAL_SECONDS=300
HOME_COLLECTION_FILE=../../data/home-collection.json
HOME_CONTENT_FILE=../../data/home-content.json
HOME_MOODBOARD_FILE=../../data/home-moodboard.json
HOME_MEDIA_DIRECTORY=../../data/media
# Production only: serve the built SPA from the API process.
# STATIC_ROOT=../website/dist

# Dedicated Home database for shared comments and notes.
NOTION_FEEDBACK_DATA_SOURCE_ID=
NOTION_FEEDBACK_CACHE_FILE=../../data/notion-feedback.json
NOTION_FEEDBACK_JOURNAL_FILE=../../data/notion-feedback-operations.json

HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
# Generate local random credentials with pnpm demo:setup. Never commit .env.
DATABASE_URL=postgresql://home:replace-with-local-database-password@127.0.0.1:55432/home_plain
POSTGRES_USER=home
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=home_plain
DATABASE_PORT=55432
HOME_MEDIA_DIRECTORY=../../data/media
# Bootstrap only; authentication and membership data subsequently live in PostgreSQL.
HOUSEHOLD_ID=00000000-0000-4000-8000-000000000902
HOUSEHOLD_NAME=Hogar de ejemplo
AUTH_SHARED_USERNAME=home
AUTH_SHARED_PASSWORD_HASH=
AUTH_OWNER_USERNAME=owner
AUTH_OWNER_PASSWORD_HASH=
# Generate hashes if configuring manually:
# pnpm --filter @repo/api exec node --import=tsx ../../scripts/hash-password.ts < /path/to/private-password-file
# Quote hashes with single quotes to preserve dollar signs.
# STATIC_ROOT=../website/dist

# Optional planning agent. Leave both empty to disable model calls.
# Requests send the chosen goal and up to 50 room purchases to OpenAI.
OPENAI_API_KEY=
AGENT_MODEL=
